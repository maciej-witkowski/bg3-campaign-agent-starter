{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "equip_item",
  "type": "object",
  "required": ["character", "item", "slot", "old_item_destination", "confirmation"],
  "properties": {
    "character": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "item": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "slot": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "old_item_destination": {"enum": ["CHEST","SITUATIONAL","PERSONAL_STORY"]},
    "confirmation": {"$ref": "../domain/confirmation.schema.json"}
  },
  "additionalProperties": false
}
