{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignIntent",
  "type": "object",
  "required": ["type", "confidence", "mutation_semantics"],
  "properties": {
    "type": {
      "enum": [
        "NEW_ITEM","MERCHANT_ITEMS","COMPARE_ITEM","EQUIP_ITEM","SELL_ITEM",
        "LEVEL_UP","RESPEC","SPELL_CHANGE","ILLITHID_POWER","PARTY_STATUS",
        "INVENTORY_QUERY","CHECKPOINT","UNDO","GENERAL_BG3_QUESTION","UNKNOWN"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "mutation_semantics": {"enum": ["READ_ONLY","PROPOSAL","DIRECT_FACT","CONFIRMATION","UNKNOWN"]},
    "entities": {"type": "object"}
  },
  "additionalProperties": false
}
