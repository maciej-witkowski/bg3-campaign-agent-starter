{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MutationConfirmation",
  "oneOf": [
    {
      "type": "object",
      "required": ["proposal_id"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["direct_fact", "source_utterance"],
      "properties": {
        "direct_fact": {"const": true},
        "source_utterance": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    }
  ]
}
