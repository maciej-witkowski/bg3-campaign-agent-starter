{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bg3-agent/schemas/tool-result.schema.json",
  "title": "ToolResult",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "data", "warnings"],
      "properties": {
        "ok": {"const": true},
        "data": {},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["ok", "error", "warnings"],
      "properties": {
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "message_pl"],
          "properties": {
            "code": {"type": "string"},
            "message_pl": {"type": "string"},
            "details": {}
          },
          "additionalProperties": false
        },
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  ]
}
